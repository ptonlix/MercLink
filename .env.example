# 只写变量名。不要在这个文件里填写真实密钥、密码或连接串。

# PostgreSQL 连接串。应用启动前用它执行迁移。
DATABASE_URL=

# Redis 连接串。短信和上传限流共用。缺少时应用拒绝启动。compose.dev.yaml 只发布到 127.0.0.1:6379。
# 正式 compose.yaml 会用内部地址覆盖这个值，密码来自 REDIS_PASSWORD。
REDIS_URL=

# 首次启动时创建唯一超级管理员的手机号。已有超管后不再使用。
ADMIN_PHONE=

# 超级管理员初始密码。只在首次创建时使用，首次登录后必须修改。
ADMIN_PASSWORD=

# 授权服务签名和登录会话的密钥。不要复用其他系统的密钥。
OAUTH_SIGNING_SECRET=

# 阿里云验证码 2.0 的 AccessKey ID。只放服务端，用于调用 VerifyIntelligentCaptcha。
ALIYUN_CAPTCHA_ACCESS_KEY_ID=

# 阿里云验证码 2.0 的 AccessKey Secret。日志不得记录此值。
ALIYUN_CAPTCHA_ACCESS_KEY_SECRET=

# 验证码场景 ID。服务端校验时传入，买家页也用它初始化图形校验。
ALIYUN_CAPTCHA_SCENE_ID=

# 验证码身份标。控制台概览页获取，只给买家页设置 AliyunCaptchaConfig.prefix，不参与服务端验签。
ALIYUN_CAPTCHA_PREFIX=

# 阿里云号码认证短信的 AccessKey ID。验证码通过后才允许调用发送接口。
ALIYUN_SMS_ACCESS_KEY_ID=

# 阿里云号码认证短信的 AccessKey Secret。日志不得记录此值。
ALIYUN_SMS_ACCESS_KEY_SECRET=

# 短信签名。必须是号码认证控制台已审核通过的签名。
ALIYUN_SMS_SIGN_NAME=

# 短信模板编号。必须是号码认证控制台已审核通过的验证码模板。
ALIYUN_SMS_TEMPLATE_CODE=

# 支付宝应用 AppId。国内支付走官方 alipay-sdk。
ALIPAY_APP_ID=

# 支付宝应用私钥。只存在于服务端，用于请求签名。
ALIPAY_PRIVATE_KEY=

# 支付宝公钥。用于校验支付通知和查询结果，不是应用私钥。
ALIPAY_PUBLIC_KEY=

# 支付宝异步通知地址。必须是公网可访问的本应用通知路由。
ALIPAY_NOTIFY_URL=

# 本应用的公开绝对地址，例如 https://shop.example。用于授权元数据和页面绝对链接。
APP_BASE_URL=

# S3 或 MinIO 的访问端点。图片字节只写入这个端点上的桶，不写本地磁盘。
OBJECT_STORAGE_ENDPOINT=

# 对象存储区域。MinIO 也要填写，例如 us-east-1。
OBJECT_STORAGE_REGION=

# 对象存储桶名。启动时会检查桶是否可达。
OBJECT_STORAGE_BUCKET=

# 对象存储访问密钥 ID。日志不得记录此值。
OBJECT_STORAGE_ACCESS_KEY_ID=

# 对象存储访问密钥。日志不得记录此值。
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# 可选。支付产品：留空或 domestic 使用国内支付宝；alipayplus 在国际请求字段进入合同前会拒绝支付。
# ALIPAY_PRODUCT=

# 启动时唯一支付实现。alipay 或 easypay。不设置时新订单仍用官方支付宝。
# MERCLINK_PAYMENT_PROVIDER=

# 易支付商户号、密钥、API 根地址和通知地址。只有启动实现是 easypay 时，新下单才需要。
# 密钥只放服务端。查单和退款把密钥放在 POST 正文，不放进 URL。
# 反向代理必须覆盖 x-real-ip，或在 x-forwarded-for 末尾追加真实连接地址。
# 应用不信任调用方自己写的第一跳，也不用该地址猜测 payment_channel。
# EASYPAY_PID=
# EASYPAY_KEY=
# EASYPAY_API_BASE=
# EASYPAY_NOTIFY_URL=

# 只在 pnpm dev（NODE_ENV=development）时设为 1：不调用阿里云验证码、短信和支付宝。短信验证码固定为 123456。
# 下单返回的 payment.action 打开后，在页面确认模拟支付。NODE_ENV=production 时设置此项会拒绝启动。
# MERCLINK_DEV_STUBS=

# 正式 compose.yaml 启动 Postgres、Redis 和 MinIO 时读取。本地 compose.dev.yaml 不使用。不要填写真实密码。
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# OBJECT_STORAGE_BUCKET=
# APP_PORT=
# APP_BIND=
